:8080 {
# CAM-CADDY-TLS: WEB
  root * /srv/web
  encode gzip zstd

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options SAMEORIGIN
    Cache-Control "no-cache"
  }

  handle_path /agent/* {
    # In production Core and Agent may be deployed on separate hosts. The
    # upstream is therefore supplied by the Core deployment environment.
    reverse_proxy {$CAM_AGENT_UPSTREAM:host.docker.internal:3111}
  }

  handle /api/* {
    reverse_proxy cam-core:3102
  }

  handle {
    try_files {path} /index.html
    file_server
  }
}

# The gateway exposes separate control and transfer channels.  They currently
# share the Core API upstream; the distinction is represented by the mapped
# listener/host ports and the corresponding CAM_GATE_*_URL values.
:8102 {
# CAM-CADDY-TLS: CONTROL
  reverse_proxy cam-core:3102
}

:8202 {
# CAM-CADDY-TLS: TRANSFER
  reverse_proxy cam-core:3102
}
