# Merge these site blocks into the existing host-network Caddy Caddyfile.
# Keep the existing global options and AliDNS DNS challenge configuration.

https://cam-edge.cexp.cn:24443 {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	reverse_proxy 127.0.0.1:8088
}

https://cam-core.cexp.cn:24443 {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	@core_api path /api/*
	handle @core_api {
		reverse_proxy 127.0.0.1:3102
	}

	@core_health path /health/live /health/ready
	handle @core_health {
		reverse_proxy 127.0.0.1:3102
	}

	handle {
		reverse_proxy 127.0.0.1:8092
	}
}

https://cam-ag1.cexp.cn:24443 {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	reverse_proxy 127.0.0.1:3111
}

https://cam-ag2.cexp.cn:24443 {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	reverse_proxy 127.0.0.1:3112
}
