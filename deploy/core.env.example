# CAM Core deployment. Copy to core.env on the target host and keep it private.
CAM_CORE_IMAGE=cam-core:1.0.0
CAM_CORE_WEB_IMAGE=cam-core-web:1.0.0
CAM_CORE_DATA_DIR=/var/lib/cloud-artifact-management/core
CAM_LOG_MAX_BYTES=52428800
CAM_LOG_MAX_FILES=5
CAM_LOG_COLLECTION_MAX_BYTES=104857600
CAM_DOCKER_SUBNET=192.168.242.0/24
CAM_CORE_API_BIND=127.0.0.1
CAM_CORE_API_PORT=3102
CAM_CORE_WEB_BIND=127.0.0.1
CAM_CORE_WEB_PORT=8092
CAM_COOKIE_SECURE=true
CAM_TRUST_PROXY=192.168.242.0/24
# Agent web/API upstream as reachable from the Core Web container.
CAM_AGENT_UPSTREAM=host.docker.internal:3111
CAM_GATE_MODE=mapping
# Virtual mapped addresses provided by the gate; include the virtual port.
# The gate's target is this host's CAM_CORE_API_PORT (default 3102), not Web 8092.
# Business paths are fixed in code.
CAM_GATE_EDGE_CONTROL_URL=
CAM_GATE_EDGE_TRANSFER_URL=
CAM_GATE_CONNECT_TIMEOUT_MS=10000
CAM_GATE_TRANSFER_TIMEOUT_MS=60000
CAM_GATE_TRANSFER_START_TIMEOUT_MS=120000
CAM_GATE_TRANSFER_IDLE_TIMEOUT_MS=90000
CAM_GATE_TRANSFER_HEARTBEAT_MS=15000
CAM_GATE_CHUNK_SIZE_BYTES=268435456
CAM_GATE_RETRY_LIMIT=5
CAM_GATE_MAX_IN_FLIGHT_CHUNKS=1
CAM_GATE_REQUEST_TTL_SECONDS=86400
CAM_GATE_TLS_CA_FILE=
CAM_GATE_TLS_SERVER_NAME=
# Cloud manager API. Put real secret only in this ignored deployment file.
CAM_CLOUD_API_BASE_URL=
CAM_CLOUD_AUTH_USER_ID=
CAM_CLOUD_AUTH_USERNAME=
CAM_CLOUD_AUTH_SECRET=
CAM_CLOUD_WORK_ORDER_PRIORITY_LABEL=常规变更
CAM_CLOUD_WORK_ORDER_PRIORITY_VALUE=
CAM_CLOUD_WORK_ORDER_SOURCE_LABEL=内部需求
CAM_CLOUD_WORK_ORDER_SOURCE_VALUE=
CAM_CLOUD_WORK_ORDER_BUSINESS_TYPE_PATH=平台类/其他
CAM_CLOUD_WORK_ORDER_DEPT_NAME=成都
CAM_CLOUD_WORK_ORDER_TEAM_NAME=OpenStack平台运维
CAM_CLOUD_WORK_ORDER_PROCESS_USER_NAMES=
CAM_CLOUD_WORK_ORDER_TITLE_PREFIX=云平台制品验证报告审批
CAM_CLOUD_TIMEOUT_MS=10000
# AAA. Keep credentials private; certificate validation should remain enabled.
CAM_AAA_BASE_URL=
CAM_AAA_TENANT_NAME=
CAM_AAA_ACCESS_SERVER_NAME=
CAM_AAA_SHARED_SECRET=
CAM_AAA_TIMEOUT_MS=10000
CAM_AAA_ALLOW_HTTP=false
CAM_AAA_SKIP_TLS_VERIFICATION=false
