# CAM Core deployment. Keep the real file private (chmod 600).
# Compose supplies safe defaults for ports, timeouts, retry and logging.

# Image names imported on this host.
CAM_CORE_IMAGE=cam-backend:0.2.4
CAM_CORE_WEB_IMAGE=cam-core-web:0.2.4

# Required persistent storage for the Core database, identity and artifacts.
CAM_CORE_DATA_DIR=/var/lib/cloud-artifact-management/core

# Agent Web address reachable from the Core Web container. Keep the default
# for a same-host single-Agent deployment; change it for a remote Agent.
# CAM_AGENT_UPSTREAM=host.docker.internal:3111

# Cloud manager connection credentials. Work-order labels and dictionary
# mappings are configured in the Core page after startup.
CAM_CLOUD_API_BASE_URL=
CAM_CLOUD_AUTH_USER_ID=
CAM_CLOUD_AUTH_SECRET=

# Keep true when the personnel page is served over HTTPS. Set false only for
# an isolated HTTP-only test deployment.
CAM_COOKIE_SECURE=true

# Optional deployment overrides (normally leave commented):
# CAM_GATE_EDGE_CONTROL_URL=
# CAM_CORE_WEB_BIND=127.0.0.1
# CAM_CORE_WEB_PORT=8092
# CAM_CORE_CONTROL_BIND=127.0.0.1
# CAM_CORE_CONTROL_PORT=8102
# CAM_CORE_TRANSFER_BIND=127.0.0.1
# CAM_CORE_TRANSFER_PORT=8202
# CAM_CORE_TLS_DIR=/var/lib/cloud-artifact-management/core/tls
# CAM_CORE_WEB_HTTPS=false
# CAM_CORE_CONTROL_HTTPS=false
# CAM_CORE_TRANSFER_HTTPS=false
# CAM_CORE_WEB_TLS_CERT_FILE=/tls/fullchain.pem
# CAM_CORE_WEB_TLS_KEY_FILE=/tls/privkey.pem
# CAM_CORE_CONTROL_TLS_CERT_FILE=/tls/fullchain.pem
# CAM_CORE_CONTROL_TLS_KEY_FILE=/tls/privkey.pem
# CAM_CORE_TRANSFER_TLS_CERT_FILE=/tls/fullchain.pem
# CAM_CORE_TRANSFER_TLS_KEY_FILE=/tls/privkey.pem
# CAM_DOCKER_SUBNET=192.168.242.0/24
# CAM_TRUST_PROXY=192.168.242.0/24
# CAM_GATE_TLS_CA_FILE=
# CAM_GATE_TLS_SERVER_NAME=
# CAM_CLOUD_AUTH_USERNAME=
