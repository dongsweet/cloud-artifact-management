# CAM deployment defaults. Copy to deploy/.env on the target host and adjust
# only the values approved for that environment. Do not commit the real file.
CAM_SOURCE_ALLOWLIST=172.22.5.177
CAM_DOCKER_SUBNET=192.168.240.0/24
HILLSTONE_IMAGE=ghcrproxy.sweethome.vip/w101723/hillstone-connect@sha256:c6315f16ef13f804e0740e3e1b7158036cd7097ce41ff6e2629828b85babf9a8
HILLSTONE_CONTAINER_NAME=cam-hillstone-vpn
HILLSTONE_VNC_PORT=16080
HILLSTONE_SOCKS_PORT=11080
HILLSTONE_WEB_PORT=18080
CAM_HILLSTONE_NETWORK=cloud-artifact-management_default
CAM_HILLSTONE_ROUTE_TARGETS=172.22.5.177/32
CAM_HILLSTONE_ROUTE_WAIT_SECONDS=180
# CAM application data is stored directly on the host filesystem.
CAM_EDGE_DATA_DIR=/var/lib/cloud-artifact-management/edge
CAM_CORE_DATA_DIR=/var/lib/cloud-artifact-management/core
CAM_AGENT_DATA_DIR=/var/lib/cloud-artifact-management/agent
# Hillstone keeps its own client state in Docker-managed volumes.
CAM_HILLSTONE_CONFIG_VOLUME=cloud-artifact-management_hillstone-config
CAM_HILLSTONE_DATA_VOLUME=cloud-artifact-management_hillstone-data
