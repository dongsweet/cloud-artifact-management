# CAM deployment defaults. Copy to deploy/.env on the target host and adjust
# only the values approved for that environment. Do not commit the real file.
CAM_SOURCE_ALLOWLIST=172.22.5.177,172.22.5.66
CAM_DOCKER_SUBNET=192.168.240.0/24
# Secure cookies are required for HTTPS. Only controlled HTTP testing uses false.
CAM_COOKIE_SECURE=true
CAM_APPROVAL_MODE=cloud
# Trust only the Caddy proxy network; adjust with CAM_DOCKER_SUBNET.
CAM_TRUST_PROXY=192.168.240.0/24
# CAM application data is stored directly on the host filesystem.
CAM_EDGE_DATA_DIR=/var/lib/cloud-artifact-management/edge
CAM_CORE_DATA_DIR=/var/lib/cloud-artifact-management/core
CAM_AGENT_DATA_DIR=/var/lib/cloud-artifact-management/agent
# The gate identity is injected into the core container and is not stored in SQLite.
CAM_GATE_SHARED_SECRET=
# Configure these only after the cloud manager API contract and TLS trust are confirmed.
CAM_CLOUD_API_BASE_URL=
CAM_CLOUD_API_TOKEN_FILE=
CAM_CLOUD_HTTP_PROXY=
CAM_CLOUD_CREATE_PATH=/api/v1/release-approvals
CAM_CLOUD_STATUS_PATH=/api/v1/release-approvals/{approvalId}
CAM_CLOUD_CLOSE_PATH=/api/v1/release-approvals/{approvalId}/close
CAM_CLOUD_TIMEOUT_MS=10000
# Test-only: targets reached through the existing cloud-growth EasyConnect
# container. Used by deploy/install-cam-cloud-route.sh, not by production.
# CAM_CLOUD_ROUTE_TARGETS=100.127.2.101/32
# CAM_CLOUD_ROUTE_NETWORK=cloud-growth-tracker_default
# CAM_CLOUD_ROUTE_GATEWAY_CONTAINER=easyconnect-vpn
# CAM_CLOUD_ROUTE_CLIENT_CONTAINERS=cloud-artifact-management-cam-core-1 cloud-growth-tracker-app-1
