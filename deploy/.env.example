# CAM deployment defaults. Copy to deploy/.env on the target host and adjust
# only the values approved for that environment. Do not commit the real file.
CAM_SOURCE_ALLOWLIST=172.22.5.177,172.22.5.66
CAM_DOCKER_SUBNET=192.168.240.0/24
# Secure cookies are required for HTTPS. Only controlled HTTP testing uses false.
CAM_COOKIE_SECURE=true
CAM_APPROVAL_MODE=cloud
# Trust only the Caddy proxy network; adjust with CAM_DOCKER_SUBNET.
CAM_TRUST_PROXY=192.168.240.0/24
# CAM application data is stored directly on the host filesystem.
CAM_EDGE_DATA_DIR=/var/lib/cloud-artifact-management/edge
CAM_CORE_DATA_DIR=/var/lib/cloud-artifact-management/core
CAM_AGENT_DATA_DIR=/var/lib/cloud-artifact-management/agent
# The gate identity is injected into the core container and is not stored in SQLite.
CAM_GATE_SHARED_SECRET=
# During rotation, keep the old value here only for the short overlap window;
# remove it after both exchange sides confirm the new secret.
CAM_GATE_PREVIOUS_SHARED_SECRET=
# Hillstone production integration. The current code keeps these as deployment
# contracts; the mapping adapter will consume them when cross-zone transport is
# enabled. URLs contain the Hillstone virtual address, never a real private
# service address. Keep business paths fixed in code.
CAM_GATE_MODE=mapping
CAM_GATE_CORE_CONTROL_URL=
CAM_GATE_CORE_TRANSFER_URL=
CAM_GATE_EDGE_CONTROL_URL=
CAM_GATE_EDGE_TRANSFER_URL=
CAM_GATE_CONNECT_TIMEOUT_MS=10000
CAM_GATE_TRANSFER_TIMEOUT_MS=60000
CAM_GATE_CHUNK_SIZE_BYTES=268435456
CAM_GATE_RETRY_LIMIT=5
CAM_GATE_MAX_IN_FLIGHT_CHUNKS=1
CAM_GATE_REQUEST_TTL_SECONDS=86400
# Optional CA bundle for the mapped HTTPS endpoints; leave empty when the
# endpoint certificate is trusted by the container image.
CAM_GATE_TLS_CA_FILE=
CAM_GATE_TLS_SERVER_NAME=
# EOMS cloud manager API. The cam-core EOMS adapter will consume these values.
# The API document specifies the gateway at port 9006 and X-Auth-Secret /
# X-Auth-UserId headers; this is not a username/password login.
# Only the base URL is configurable; EOMS endpoint paths are fixed in cam-core.
CAM_CLOUD_API_BASE_URL=
CAM_CLOUD_AUTH_USER_ID=
# Optional; omit to let EOMS derive user_{userId}.
CAM_CLOUD_AUTH_USERNAME=
# Gateway secret. Keep the real value only in the ignored deploy/.env on the host.
CAM_CLOUD_AUTH_SECRET=
# Environment-specific work order labels/paths. Numeric dictionary IDs are
# resolved from the connected cloud manager whenever an approval is submitted.
CAM_CLOUD_WORK_ORDER_PRIORITY_LABEL=常规变更
# Optional stable dictValue selector; when supplied, both label and value must match.
CAM_CLOUD_WORK_ORDER_PRIORITY_VALUE=
CAM_CLOUD_WORK_ORDER_SOURCE_LABEL=内部需求
CAM_CLOUD_WORK_ORDER_SOURCE_VALUE=
CAM_CLOUD_WORK_ORDER_BUSINESS_TYPE_PATH=平台类/其他
CAM_CLOUD_WORK_ORDER_DEPT_NAME=成都
CAM_CLOUD_WORK_ORDER_TEAM_NAME=OpenStack平台运维
# User IDs are environment-specific and intentionally configured here.
CAM_CLOUD_WORK_ORDER_PROCESS_USER_IDS=
CAM_CLOUD_WORK_ORDER_TITLE_PREFIX=云平台制品验证报告审批
CAM_CLOUD_TIMEOUT_MS=10000
