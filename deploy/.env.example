# Direct-connect development/test Compose only. Keep the real file private.
# compose.direct.yaml supplies the in-network gateway simulator addresses and
# all service defaults; only local storage and test-specific values are here.

CAM_EDGE_DATA_DIR=/var/lib/cloud-artifact-management/edge
CAM_CORE_DATA_DIR=/var/lib/cloud-artifact-management/core
CAM_AGENT_1_DATA_DIR=/var/lib/cloud-artifact-management/agent-1
CAM_AGENT_2_DATA_DIR=/var/lib/cloud-artifact-management/agent-2

# Optional but recommended for candidate downloads; configure the same value
# later in the Edge page if omitted here.
# CAM_SOURCE_ALLOWLIST=
# CAM_MAX_CANDIDATE_SIZE=2199023255552

# Direct test pages use HTTP. Set true only when the test Caddy entries use TLS.
CAM_COOKIE_SECURE=false

# Optional cloud-manager connection for direct approval tests. Keep the real
# secret only in deploy/.env; work-order labels and mappings are configured in
# the Core page.
# CAM_CLOUD_API_BASE_URL=
# CAM_CLOUD_AUTH_USER_ID=
# CAM_CLOUD_AUTH_SECRET=

# Optional: change only when the host or another Docker project has a subnet
# conflict. Do not copy production gateway/cloud/AAA secrets into this file.
# CAM_DOCKER_SUBNET=192.168.240.0/24
# CAM_TRUST_PROXY=192.168.240.0/24
