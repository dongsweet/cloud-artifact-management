[Unit]
Description=CAM test cloud-manager routes through the VPN gateway container
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/cam-cloud-route
ExecStart=/usr/local/sbin/cam-cloud-route
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
