# CAM Agent deployment. Keep the real file private (chmod 600).
# Compose supplies defaults for polling, chunking, concurrency and logging.

# Image names imported on this host.
CAM_AGENT_IMAGE=cam-backend:0.2.4
CAM_AGENT_WEB_IMAGE=cam-agent-web:0.2.4

# Required persistent storage for identity, database and content-addressed cache.
CAM_DATA_DIR=/var/lib/cloud-artifact-management/agent

# Keep true when the personnel page is served over HTTPS. Set false only for
# an isolated HTTP-only test deployment.
CAM_COOKIE_SECURE=true

# AAA, Core address/public key and Agent identity are configured after startup
# from the Agent/Core pages. Do not put user passwords or private keys here.

# Optional deployment overrides (normally leave commented).  The embedded
# Caddy publishes the public web ports directly; its internal listeners stay
# unprivileged (8080/8443).
# CAM_AGENT_WEB_HTTP_BIND=0.0.0.0
# CAM_AGENT_WEB_HTTP_PORT=80
# CAM_AGENT_WEB_HTTPS_BIND=0.0.0.0
# CAM_AGENT_WEB_HTTPS_PORT=443
# CAM_AGENT_TLS_DIR=/var/lib/cloud-artifact-management/agent/tls
# CAM_AGENT_WEB_HTTPS=false
# CAM_AGENT_WEB_TLS_CERT_FILE=/tls/fullchain.pem
# CAM_AGENT_WEB_TLS_KEY_FILE=/tls/privkey.pem
# CAM_AGENT_UPSTREAM=cam-agent:3103
# CAM_DOCKER_SUBNET=192.168.243.0/24
# CAM_TRUST_PROXY=192.168.243.0/24
