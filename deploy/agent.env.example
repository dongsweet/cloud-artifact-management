# CAM Agent deployment. Copy to agent.env on the target host and keep it private.
CAM_AGENT_IMAGE=cam-agent:1.0.0
CAM_AGENT_DATA_DIR=/var/lib/cloud-artifact-management/agent
CAM_LOG_MAX_BYTES=52428800
CAM_LOG_MAX_FILES=5
CAM_LOG_COLLECTION_MAX_BYTES=104857600
CAM_DOCKER_SUBNET=192.168.243.0/24
CAM_AGENT_API_BIND=127.0.0.1
CAM_AGENT_API_PORT=3111
CAM_COOKIE_SECURE=true
CAM_TRUST_PROXY=192.168.243.0/24
# Reachable Core API base URL, including scheme and port if required.
CAM_CORE_URL=https://cam-core.internal.example
CAM_AGENT_POLL_MS=5000
CAM_AGENT_CHUNK_SIZE=4194304
CAM_AGENT_CONCURRENCY=4
# Agent authenticates directly to AAA. Leave empty only in a deliberate local-only test setup.
CAM_AAA_BASE_URL=
CAM_AAA_TENANT_NAME=
CAM_AAA_ACCESS_SERVER_NAME=
CAM_AAA_SHARED_SECRET=
CAM_AAA_TIMEOUT_MS=10000
CAM_AAA_ALLOW_HTTP=false
CAM_AAA_SKIP_TLS_VERIFICATION=false
