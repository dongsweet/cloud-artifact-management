# CAM Edge deployment. Keep the real file private (chmod 600).
# Compose supplies safe defaults for ports, timeouts, retry and logging.

# Image names imported on this host.
CAM_EDGE_IMAGE=cam-backend:0.2.4
CAM_EDGE_WEB_IMAGE=cam-edge-web:0.2.4

# Required persistent storage. It must have enough space for candidate files.
CAM_DATA_DIR=/var/lib/cloud-artifact-management/edge

# Required bootstrap route: Edge delegates login and control callbacks to Core.
# This value is deployment-owned and is read-only in the Edge page.
CAM_GATE_CORE_CONTROL_URL=

# Optional: if the transfer route is not entered on the Edge page, set it here.
# CAM_GATE_CORE_TRANSFER_URL=

# Keep true when the personnel page is served over HTTPS. Set false only for
# an isolated HTTP-only test deployment.
CAM_COOKIE_SECURE=true

# Optional deployment overrides (normally leave commented).  The embedded
# Caddy publishes the public web ports directly; its internal listeners stay
# unprivileged (8080/8443).
# CAM_SOURCE_ALLOWLIST=
# CAM_MAX_CANDIDATE_SIZE=2199023255552
# CAM_EDGE_WEB_HTTP_BIND=0.0.0.0
# CAM_EDGE_WEB_HTTP_PORT=80
# CAM_EDGE_WEB_HTTPS_BIND=0.0.0.0
# CAM_EDGE_WEB_HTTPS_PORT=443
# CAM_EDGE_CONTROL_BIND=0.0.0.0
# CAM_EDGE_CONTROL_PORT=8101
# CAM_EDGE_TLS_DIR=/var/lib/cloud-artifact-management/edge/tls
# CAM_EDGE_WEB_HTTPS=false
# CAM_EDGE_CONTROL_HTTPS=false
# CAM_EDGE_WEB_TLS_CERT_FILE=/tls/fullchain.pem
# CAM_EDGE_WEB_TLS_KEY_FILE=/tls/privkey.pem
# CAM_EDGE_CONTROL_TLS_CERT_FILE=/tls/fullchain.pem
# CAM_EDGE_CONTROL_TLS_KEY_FILE=/tls/privkey.pem
# CAM_DOCKER_SUBNET=192.168.241.0/24
# CAM_TRUST_PROXY=192.168.241.0/24
# CAM_GATE_TLS_CA_FILE=
# CAM_GATE_TLS_SERVER_NAME=
