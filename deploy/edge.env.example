# CAM Edge deployment. Copy to edge.env on the target host and keep it private.
CAM_EDGE_IMAGE=cam-edge:1.0.0
CAM_EDGE_WEB_IMAGE=cam-edge-web:1.0.0
CAM_EDGE_DATA_DIR=/var/lib/cloud-artifact-management/edge
CAM_LOG_MAX_BYTES=52428800
CAM_LOG_MAX_FILES=5
CAM_LOG_COLLECTION_MAX_BYTES=104857600
CAM_DOCKER_SUBNET=192.168.241.0/24
# Bind to loopback when a host reverse proxy publishes HTTPS; change only when needed.
CAM_EDGE_API_BIND=127.0.0.1
CAM_EDGE_API_PORT=3101
CAM_EDGE_WEB_BIND=127.0.0.1
CAM_EDGE_WEB_PORT=8088
# Caddy channel TLS. Keep false for the current HTTP deployment. When enabled,
# the certificate paths below are inside the container's read-only /tls mount.
CAM_EDGE_TLS_DIR=/var/lib/cloud-artifact-management/edge/tls
CAM_EDGE_WEB_HTTPS=false
CAM_EDGE_WEB_TLS_CERT_FILE=/tls/fullchain.pem
CAM_EDGE_WEB_TLS_KEY_FILE=/tls/privkey.pem
# Separate HTTP entry points for the gateway control and transfer channels.
CAM_EDGE_CONTROL_BIND=127.0.0.1
CAM_EDGE_CONTROL_PORT=8101
CAM_EDGE_CONTROL_HTTPS=false
CAM_EDGE_CONTROL_TLS_CERT_FILE=/tls/fullchain.pem
CAM_EDGE_CONTROL_TLS_KEY_FILE=/tls/privkey.pem
CAM_EDGE_TRANSFER_BIND=127.0.0.1
CAM_EDGE_TRANSFER_PORT=8201
CAM_EDGE_TRANSFER_HTTPS=false
CAM_EDGE_TRANSFER_TLS_CERT_FILE=/tls/fullchain.pem
CAM_EDGE_TRANSFER_TLS_KEY_FILE=/tls/privkey.pem
CAM_COOKIE_SECURE=true
CAM_TRUST_PROXY=192.168.241.0/24
CAM_SOURCE_ALLOWLIST=
CAM_MAX_CANDIDATE_SIZE=2199023255552
CAM_APPROVAL_MODE=cloud
CAM_GATE_MODE=mapping
# Virtual mapped addresses provided by the gate; include the virtual port.
# The gate's target is this host's CAM_EDGE_API_PORT (default 3101), not Web 8088.
# Business paths are fixed in code.
CAM_GATE_CORE_CONTROL_URL=
CAM_GATE_CORE_TRANSFER_URL=
CAM_GATE_CONNECT_TIMEOUT_MS=10000
CAM_GATE_TRANSFER_TIMEOUT_MS=60000
CAM_GATE_TRANSFER_START_TIMEOUT_MS=120000
CAM_GATE_TRANSFER_IDLE_TIMEOUT_MS=90000
CAM_GATE_TRANSFER_HEARTBEAT_MS=15000
CAM_GATE_CHUNK_SIZE_BYTES=268435456
CAM_GATE_RETRY_LIMIT=5
CAM_GATE_MAX_IN_FLIGHT_CHUNKS=1
CAM_GATE_REQUEST_TTL_SECONDS=86400
CAM_GATE_TLS_CA_FILE=
CAM_GATE_TLS_SERVER_NAME=
