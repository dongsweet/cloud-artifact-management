:8080 {
  encode gzip zstd

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options SAMEORIGIN
  }

  root * /srv/web

  handle /api/* {
    reverse_proxy {$CAM_AGENT_UPSTREAM:cam-agent:3103}
  }

  handle /health/* {
    reverse_proxy {$CAM_AGENT_UPSTREAM:cam-agent:3103}
  }

  handle {
    try_files {path} /index.html
    file_server
  }
}
