:8080 {
# CAM-CADDY-TLS: WEB
  root * /srv/web
  encode gzip zstd

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options SAMEORIGIN
    Cache-Control "no-cache"
  }

  handle /api/* {
    reverse_proxy cam-edge:3101
  }

  handle {
    try_files {path} /index.html
    file_server
  }
}

# The gateway exposes separate control and transfer channels.  They currently
# share the Edge API upstream; the distinction is represented by the mapped
# listener/host ports and the corresponding CAM_GATE_*_URL values.
:8101 {
# CAM-CADDY-TLS: CONTROL
  reverse_proxy cam-edge:3101
}

:8201 {
# CAM-CADDY-TLS: TRANSFER
  reverse_proxy cam-edge:3101
}
