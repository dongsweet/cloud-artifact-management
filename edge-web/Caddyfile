CAM-CADDY-WEB-ADDRESS {
# CAM-CADDY-TLS: WEB
  root * /srv/web
  encode gzip zstd

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options SAMEORIGIN
    Cache-Control "no-cache"
  }

  handle /api/* {
    reverse_proxy cam-edge:3101
  }

  handle /health/* {
    reverse_proxy cam-edge:3101
  }

  handle {
    try_files {path} /index.html
    file_server
  }
}

# The gateway exposes one Edge control/API channel.  Edge does not publish a
# separate transfer listener; transfer requests use this signed control route.
:8101 {
# CAM-CADDY-TLS: CONTROL
  reverse_proxy cam-edge:3101
}
